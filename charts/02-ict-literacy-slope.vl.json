{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Slopegraph of the share of Year 6 and Year 10 students at the proficient standard for ICT literacy in 2017, 2022 and 2025.",
  "title": {
    "text": [
      "ICT literacy fell for both year levels between 2022 and 2025"
    ],
    "subtitle": [
      "Share of students at or above the proficient standard (%). Source: ACARA NAP-ICT Literacy 2017, 2022",
      "and 2025 public reports"
    ]
  },
  "width": 560,
  "height": 340,
  "config": {
    "font": "Source Sans 3",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Source Sans 3",
      "titleFont": "DM Sans",
      "labelColor": "#3b4a5a",
      "titleColor": "#3b4a5a",
      "gridColor": "#e3e8ee",
      "domainColor": "#b8c2cc",
      "tickColor": "#b8c2cc",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600
    },
    "legend": {
      "labelFont": "Source Sans 3",
      "titleFont": "DM Sans",
      "labelColor": "#3b4a5a",
      "titleColor": "#3b4a5a",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600
    },
    "title": {
      "font": "DM Sans",
      "fontSize": 17,
      "fontWeight": 700,
      "anchor": "start",
      "color": "#16324f",
      "subtitleFont": "Source Sans 3",
      "subtitleColor": "#5b6b7b",
      "subtitleFontSize": 12.5,
      "offset": 10
    },
    "text": {
      "font": "Source Sans 3"
    }
  },
  "data": {
    "url": "processed/ictl.csv"
  },
  "layer": [
    {
      "data": {
        "values": [
          {
            "a": 2022,
            "b": 2025
          }
        ]
      },
      "mark": {
        "type": "rect",
        "color": "#fbe3da",
        "opacity": 0.7
      },
      "encoding": {
        "x": {
          "field": "a",
          "type": "quantitative",
          "scale": {
            "domain": [
              2015.5,
              2031
            ]
          },
          "axis": null
        },
        "x2": {
          "field": "b"
        },
        "y": {
          "datum": 60,
          "type": "quantitative",
          "scale": {
            "domain": [
              30,
              60
            ]
          },
          "axis": null
        },
        "y2": {
          "datum": 30
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "a": 2022.1
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "fontStyle": "normal",
        "fontSize": 12,
        "color": "#e4572e",
        "fontWeight": 600,
        "text": "Change since the last assessment",
        "baseline": "top",
        "dy": 4
      },
      "encoding": {
        "x": {
          "field": "a",
          "type": "quantitative",
          "scale": {
            "domain": [
              2015.5,
              2031
            ]
          },
          "axis": null
        },
        "y": {
          "datum": 60,
          "type": "quantitative",
          "scale": {
            "domain": [
              30,
              60
            ]
          },
          "axis": null
        }
      }
    },
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "scale": {
            "domain": [
              2015.5,
              2031
            ]
          },
          "axis": {
            "values": [
              2017,
              2022,
              2025
            ],
            "format": "d",
            "title": "Assessment year",
            "grid": false
          }
        },
        "y": {
          "field": "proficient_pct",
          "type": "quantitative",
          "scale": {
            "domain": [
              30,
              60
            ]
          },
          "axis": {
            "title": "Proficient (%)"
          }
        },
        "color": {
          "field": "level",
          "type": "nominal",
          "scale": {
            "domain": [
              "Year 6",
              "Year 10"
            ],
            "range": [
              "#2a9d8f",
              "#e4572e"
            ]
          },
          "legend": null
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 90,
        "opacity": 1
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "scale": {
            "domain": [
              2015.5,
              2031
            ]
          },
          "axis": {
            "values": [
              2017,
              2022,
              2025
            ],
            "format": "d",
            "title": "Assessment year",
            "grid": false
          }
        },
        "y": {
          "field": "proficient_pct",
          "type": "quantitative",
          "scale": {
            "domain": [
              30,
              60
            ]
          },
          "axis": {
            "title": "Proficient (%)"
          }
        },
        "color": {
          "field": "level",
          "type": "nominal",
          "scale": {
            "domain": [
              "Year 6",
              "Year 10"
            ],
            "range": [
              "#2a9d8f",
              "#e4572e"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "level",
            "title": "Level"
          },
          {
            "field": "year",
            "title": "Year",
            "format": "d"
          },
          {
            "field": "proficient_pct",
            "title": "% proficient"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year > 2017"
        }
      ],
      "mark": {
        "type": "text",
        "dy": -14,
        "fontWeight": 700,
        "fontSize": 13
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "scale": {
            "domain": [
              2015.5,
              2031
            ]
          },
          "axis": {
            "values": [
              2017,
              2022,
              2025
            ],
            "format": "d",
            "title": "Assessment year",
            "grid": false
          }
        },
        "y": {
          "field": "proficient_pct",
          "type": "quantitative",
          "scale": {
            "domain": [
              30,
              60
            ]
          },
          "axis": {
            "title": "Proficient (%)"
          }
        },
        "color": {
          "field": "level",
          "type": "nominal",
          "scale": {
            "domain": [
              "Year 6",
              "Year 10"
            ],
            "range": [
              "#2a9d8f",
              "#e4572e"
            ]
          },
          "legend": null
        },
        "text": {
          "field": "proficient_pct",
          "type": "quantitative",
          "format": ".0f"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2017"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -12,
        "fontWeight": 700,
        "fontSize": 13
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "scale": {
            "domain": [
              2015.5,
              2031
            ]
          },
          "axis": {
            "values": [
              2017,
              2022,
              2025
            ],
            "format": "d",
            "title": "Assessment year",
            "grid": false
          }
        },
        "y": {
          "field": "proficient_pct",
          "type": "quantitative",
          "scale": {
            "domain": [
              30,
              60
            ]
          },
          "axis": {
            "title": "Proficient (%)"
          }
        },
        "color": {
          "field": "level",
          "type": "nominal",
          "scale": {
            "domain": [
              "Year 6",
              "Year 10"
            ],
            "range": [
              "#2a9d8f",
              "#e4572e"
            ]
          },
          "legend": null
        },
        "text": {
          "field": "proficient_pct",
          "type": "quantitative",
          "format": ".0f"
        }
      }
    },
    {
      "transform": [
        {
          "window": [
            {
              "op": "lag",
              "field": "proficient_pct",
              "as": "prev"
            }
          ],
          "sort": [
            {
              "field": "year"
            }
          ],
          "groupby": [
            "level"
          ]
        },
        {
          "filter": "datum.year == 2025"
        },
        {
          "calculate": "datum.level + ': ' + (datum.proficient_pct - datum.prev) + ' pts since 2022'",
          "as": "lab"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 14,
        "fontWeight": 700,
        "fontSize": 13
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "scale": {
            "domain": [
              2015.5,
              2031
            ]
          },
          "axis": {
            "values": [
              2017,
              2022,
              2025
            ],
            "format": "d",
            "title": "Assessment year",
            "grid": false
          }
        },
        "y": {
          "field": "proficient_pct",
          "type": "quantitative",
          "scale": {
            "domain": [
              30,
              60
            ]
          },
          "axis": {
            "title": "Proficient (%)"
          }
        },
        "color": {
          "field": "level",
          "type": "nominal",
          "scale": {
            "domain": [
              "Year 6",
              "Year 10"
            ],
            "range": [
              "#2a9d8f",
              "#e4572e"
            ]
          },
          "legend": null
        },
        "text": {
          "field": "lab"
        }
      }
    }
  ]
}